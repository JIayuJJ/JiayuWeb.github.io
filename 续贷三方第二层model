def ToXml(table_map, rules_map, label_map, type_map, rules_file):
    root = Element("rule-set")
    rema = SubElement(root, 'remark')
    rema.text = '<![CDATA[]]>'

    # with open(rules_file) as f:
    if True:
        for data in rules_file.keys():
            reloan_type = 0
            print(data)
            if data == 'is_list1_inner_d7':
                reloan_type = '1'
            elif data == 'is_list2_inner_d7':
                reloan_type = '2'
            elif data == 'is_list3_inner_d7':
                reloan_type = '3'

            reloan_type_value = reloan_type

            reloan_type_dict = rules_file[data]
            # print('111', reloan_type_dict)
            reloan_type_list = [int(i) for i in list(reloan_type_dict.keys())]
            reloan_type_list.sort()
            # print('222', reloan_type_list)

            for i in reloan_type_list:
                group_list = [str(k) for k in reloan_type_list]
                models_dict = reloan_type_dict[str(i)]
                for j in models_dict.keys():
                    res_bin, res_score = models_dict[j][0], models_dict[j][1]
                    res_bin.sort(reverse=True)
                    res_score.sort(reverse=True)
                    # print(i, j, res_bin, res_score)

                    for m, n in enumerate(res_bin):
                        if m == 0:
                            rule = j+'>%d'%res_bin[m]
                        elif m == len(res_bin)-1:
                            rule = j + '<=%d' % res_bin[m]
                        else:
                            rule = j + '<=%d' % res_bin[m-1] + ' and ' + j + '>%d' % res_bin[m]
                        score = res_score[m]
                        # print(i, rule, score)

                        xml_rule = SubElement(root, 'rule', name="rule")
                        remark_branch = SubElement(xml_rule, 'remark')
                        remark_branch.text = '<![CDATA[]]>'

                        ret = parse(rule)
                        # print(i, rule, score, ret)
                        if hasattr(ret, "logicop"):
                            logicop = ret.logicop
                            conditions = ret.conditions
                            GenIfBranch(xml_rule, logicop, conditions, reloan_type, reloan_type_value, table_map, rules_map, label_map, type_map, str(i), group_list)
                            GenThenBranch(xml_rule, reloan_type_value, score, str(i))
                        else:
                            GenTagBranch(xml_rule, ret, reloan_type, reloan_type_value, table_map, rules_map, label_map, type_map, str(i), group_list)
                            GenThenBranch(xml_rule, reloan_type_value, score, str(i))

    tree = ElementTree(root)
    print('111', tree)
    tree.write("./rule1.text", encoding='UTF-8', xml_declaration=True)

    with open("./rule1.text", encoding='UTF-8') as f:
        res = f.read()
        res = res.replace("&lt;", '<').replace("&gt;", '>')

    with open("./rule1_format.text", 'w', encoding='UTF-8') as f:
        f.write(res)
    os.remove("./rule1.text")


