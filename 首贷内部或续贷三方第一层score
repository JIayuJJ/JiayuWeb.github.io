def GenThenBranch(parent, reloan_type_value, value: float, black_list:str, rule_type):
    then_branch = SubElement(parent, "then")
    
    black_list = black_list.strip()
    print(black_list,  '--------')

    value_attr = {
        "var-category": "参数",
        "var": "firstloan_%s_score_%s_2" % (rule_type,reloan_type_value),
        "var-label": "firstloan_%s_score_%s_2" % (rule_type,reloan_type_value),
        "datatype": "Double",
        "type": "parameter"
    }
    var_assign = SubElement(then_branch, "var-assign", attrib=value_attr)

    value_attr = {
        "var-category": "参数",
        "var": "firstloan_%s_score_%s_2" % (rule_type,reloan_type_value),
        "var-label": "firstloan_%s_score_%s_2" % (rule_type,reloan_type_value),
        "datatype": "Double",
        "type": "Parameter"
    }
    xml_value = SubElement(var_assign, "value", attrib=value_attr)

    add_attr = {
        "type": "Add"
    }
    sub_attr = {
        "type": "Sub"
    }
    if value >= 0:
        com = SubElement(xml_value, "complex-arith", attrib=add_attr)
    else:
        com = SubElement(xml_value, "complex-arith", attrib=sub_attr)

    value_attr = {
        "content": str(abs(value)),
        "type": "Input"
    }
    SubElement(com, "value", attrib=value_attr)
    else_branch = SubElement(parent, "else")
    
    
