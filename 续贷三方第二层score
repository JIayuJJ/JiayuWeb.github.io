                                GenTagBranch(xml_rule, ret, reloan_type, reloan_type_value, table_map, rules_map, label_map, type_map, str(i), group_list, 'rule')
                                GenThenBranch(xml_rule, reloan_type_value, score, str(i), 'rule')
                            else:
